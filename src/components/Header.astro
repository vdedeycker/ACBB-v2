---
interface NavigationItem {
  label: string;
  href?: string;
}

const primaryNavigation: NavigationItem[] = [
  { label: "Accueil", href: "/" },
  { label: "Entraînements", href: "/entrainements/" },
  { label: "Le club", href: "/le-club/" },
  { label: "Compétitions", href: "/competitions/" },
  { label: "Événements ACBB", href: "/evenements/" },
];

const isActive = (href?: string) => href && (
  Astro.url.pathname === href ||
  (href === "/" && Astro.url.pathname === "/")
);
---

<header class="border-b border-acbb-ink/10 bg-acbb-beige">
  <div class="site-container flex min-h-20 items-center justify-between gap-0 py-3 sm:gap-2 lg:gap-3">
    <a href="/" aria-label="ACBB - Accueil" class="shrink-0 rounded-sm">
      <img
        src="/images/branding/logo-acbb.png"
        alt="ACBB"
        width="1037"
        height="803"
        class="h-auto w-20 object-contain sm:w-24"
      />
    </a>

    <nav aria-label="Navigation principale" class="hidden items-center gap-2 lg:flex">
      {primaryNavigation.map((item) =>
        item.href ? (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class:list={[
              "inline-flex min-h-11 items-center px-2 font-semibold no-underline",
              isActive(item.href)
                ? "text-acbb-red-hover underline decoration-2 underline-offset-8"
                : "text-acbb-ink hover:text-acbb-red-hover",
            ]}
          >
            {item.label}
          </a>
        ) : (
          <span class="inline-flex min-h-11 items-center px-2 text-acbb-ink">
            {item.label}
          </span>
        ),
      )}
    </nav>

    <a
      href="https://www.facebook.com/profile.php?id=100057181820430"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Suivre l’ACBB sur Facebook"
      class="inline-flex size-11 shrink-0 items-center justify-center rounded-full text-acbb-ink no-underline hover:bg-acbb-ink/5"
    >
      <img
        src="/images/logo_facebook.png"
        alt=""
        width="20"
        height="20"
        aria-hidden="true"
        class="size-5 rounded-sm"
      />
    </a>

    <a
      href="/rejoindre/"
      aria-current={Astro.url.pathname === "/rejoindre/" ? "page" : undefined}
      class="inline-flex min-h-11 shrink-0 items-center justify-center rounded-full bg-acbb-red-hover px-1 py-2 font-semibold text-acbb-white no-underline sm:px-4"
    >
      Rejoindre l'ACBB
    </a>

    <details class="relative shrink-0 lg:hidden">
      <summary
        class="flex min-h-11 cursor-pointer list-none items-center gap-1 rounded-full border border-acbb-ink/20 px-1 font-semibold text-acbb-ink focus-visible:outline sm:gap-2 sm:px-4"
      >
        <span>Menu</span>
        <svg
          class="menu-chevron h-4 w-4"
          viewBox="0 0 20 20"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="m5 7.5 5 5 5-5"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </summary>
      <nav
        aria-label="Navigation principale"
        class="absolute right-0 z-10 mt-2 w-72 rounded-2xl border border-acbb-ink/10 bg-acbb-white p-3"
      >
        <ul class="m-0 list-none p-0">
          {primaryNavigation.map((item) =>
            item.href ? (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? "page" : undefined}
                  class:list={[
                    "flex min-h-11 items-center rounded-lg px-3 py-2 font-semibold",
                    isActive(item.href)
                      ? "text-acbb-red-hover underline decoration-2 underline-offset-4"
                      : "text-acbb-ink",
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ) : (
              <li>
                <span class="flex min-h-11 items-center px-3 py-2 text-acbb-ink">
                  {item.label}
                </span>
              </li>
            ),
          )}
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  details[open] .menu-chevron {
    transform: rotate(180deg);
  }
</style>
