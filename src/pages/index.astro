---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Fondations visuelles | ACBB">
  <section class="section-space">
    <div class="site-container">
      <p class="mb-4 text-sm font-semibold uppercase tracking-[0.12em] text-acbb-red-hover">
        Système visuel
      </p>
      <h1 class="max-w-4xl">Une base claire pour le site ACBB</h1>
      <p class="mt-6 max-w-2xl text-lg">
        Une fondation simple, lisible et accessible pour les prochaines pages.
      </p>
      <a class="button button--primary mt-8" href="#interactions">
        Voir les états interactifs
      </a>
    </div>
  </section>

  <section class="section-space bg-acbb-white" aria-labelledby="colors-heading">
    <div class="site-container">
      <h2 id="colors-heading">Couleurs</h2>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <li class="rounded-2xl border border-acbb-ink/10 p-4">
          <div class="h-20 rounded-xl bg-acbb-red" aria-hidden="true"></div>
          <p class="mt-3 font-semibold">Rouge ACBB</p>
          <p class="text-sm text-acbb-ink/75">#D94A4A</p>
        </li>
        <li class="rounded-2xl border border-acbb-ink/10 p-4">
          <div class="h-20 rounded-xl bg-acbb-red-hover" aria-hidden="true"></div>
          <p class="mt-3 font-semibold">Rouge foncé</p>
          <p class="text-sm text-acbb-ink/75">#C63F3F</p>
        </li>
        <li class="rounded-2xl border border-acbb-ink/10 p-4">
          <div class="h-20 rounded-xl bg-acbb-soft-red" aria-hidden="true"></div>
          <p class="mt-3 font-semibold">Rouge doux</p>
          <p class="text-sm text-acbb-ink/75">#F8E5E3</p>
        </li>
        <li class="rounded-2xl border border-acbb-ink/10 p-4">
          <div class="h-20 rounded-xl bg-acbb-beige" aria-hidden="true"></div>
          <p class="mt-3 font-semibold">Beige chaud</p>
          <p class="text-sm text-acbb-ink/75">#FCF5EB</p>
        </li>
        <li class="rounded-2xl border border-acbb-ink/10 p-4">
          <div class="h-20 rounded-xl bg-acbb-white ring-1 ring-inset ring-acbb-ink/10" aria-hidden="true"></div>
          <p class="mt-3 font-semibold">Blanc</p>
          <p class="text-sm text-acbb-ink/75">#FFFFFF</p>
        </li>
        <li class="rounded-2xl border border-acbb-ink/10 p-4">
          <div class="h-20 rounded-xl bg-acbb-ink" aria-hidden="true"></div>
          <p class="mt-3 font-semibold">Encre</p>
          <p class="text-sm text-acbb-ink/75">#111B21</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section-space" aria-labelledby="type-heading">
    <div class="site-container">
      <h2 id="type-heading">Typographie</h2>
      <div class="mt-8 space-y-6">
        <h3>Une hiérarchie simple et lisible</h3>
        <p class="max-w-2xl">
          La typographie système garde le site rapide et lisible sur chaque
          appareil. Le corps de texte conserve une taille minimale de 16 pixels.
        </p>
        <p>
          <a href="#interactions">Exemple de lien avec un libellé explicite</a>
        </p>
      </div>
    </div>
  </section>

  <section
    class="section-space bg-acbb-white"
    aria-labelledby="spacing-heading"
  >
    <div class="site-container">
      <h2 id="spacing-heading">Espacement et conteneur</h2>
      <p class="mt-6 max-w-2xl">
        Les sections respirent et leur contenu reste centré dans un conteneur
        qui s’adapte de l’écran mobile au grand écran.
      </p>
    </div>
  </section>

  <section id="interactions" class="section-space" aria-labelledby="interactions-heading">
    <div class="site-container">
      <h2 id="interactions-heading">États interactifs</h2>
      <p class="mt-6 max-w-2xl">
        Utilisez la touche Tab pour vérifier le focus visible et les liens
 soulignés.
      </p>
      <a class="button button--primary mt-6" href="#colors-heading">
        Revenir aux couleurs
      </a>
    </div>
  </section>
</BaseLayout>
