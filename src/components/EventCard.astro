---
import type { AcbbEvent } from "../data/events";
import { getEventStatus } from "../data/events";

interface Props {
  event: AcbbEvent;
  homepagePreview?: boolean;
}

const { event, homepagePreview = false } = Astro.props;

const date = new Date(`${event.date}T12:00:00`);
const formattedDateValue = new Intl.DateTimeFormat("fr-BE", {
  weekday: "long",
  day: "numeric",
  month: "long",
  year: "numeric",
}).format(date);
const formattedDate =
  formattedDateValue.charAt(0).toLocaleUpperCase("fr-BE") +
  formattedDateValue.slice(1);

const status = getEventStatus(event);
const statusLabel =
  status === "inscriptions-ouvertes"
    ? "Inscriptions ouvertes"
    : status === "passe"
      ? "Événement passé"
      : "À venir";
---

<article class:list={["event-card", homepagePreview && "event-card--homepage"]}>
  <div class="event-card-date">
    <time datetime={event.date}>{formattedDate}</time>
  </div>
  <div class="event-card-content">
    <p class="event-status">{statusLabel}</p>
    <h3>{event.title}</h3>
    <p class="event-card-location">
      {event.location.name} — {event.location.address}, {event.location.municipality}
    </p>
    <p class="event-card-description">{event.description}</p>
    <a class="button button--primary mt-5" href={`/evenements/${event.slug}/`}>
      Voir l'événement
    </a>
  </div>
</article>
