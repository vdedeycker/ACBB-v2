---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { events } from "../../data/events";

const event = events.find((item) => item.slug === "souper-acbb-2027");

if (!event) {
  throw new Error("L'événement Souper de l'ACBB 2027 est introuvable.");
}

const date = new Date(`${event.date}T12:00:00`);
const formattedDateValue = new Intl.DateTimeFormat("fr-BE", {
  weekday: "long",
  day: "numeric",
  month: "long",
  year: "numeric",
}).format(date);
const formattedDate =
  formattedDateValue.charAt(0).toLocaleUpperCase("fr-BE") +
  formattedDateValue.slice(1);

const registrationDeadline = event.registrationDeadline
  ? new Intl.DateTimeFormat("fr-BE", {
      weekday: "long",
      day: "numeric",
      month: "long",
      year: "numeric",
    }).format(new Date(`${event.registrationDeadline}T12:00:00`))
  : null;
---

<BaseLayout
  title={`${event.title} - ACBB`}
  description={event.description}
>
  <article>
    <section class="event-detail-hero bg-acbb-beige" aria-labelledby="event-title">
      <div class="site-container py-10 md:py-12">
        <p class="mb-4 text-sm font-bold uppercase tracking-[0.12em] text-acbb-red-hover">
          Événement ACBB
        </p>
        <h1 id="event-title">{event.title}</h1>

        <dl class="event-detail-facts mt-6 md:mt-8">
          <div>
            <dt>Date</dt>
            <dd><time datetime={event.date}>{formattedDate}</time></dd>
          </div>
          {event.startTime && (
            <div>
              <dt>Horaire</dt>
              <dd>À partir de {event.startTime.replace(":", "h")}</dd>
            </div>
          )}
          <div>
            <dt>Lieu</dt>
            <dd>
              {event.location.name}<br />
              {event.location.address}<br />
              {event.location.municipality}
            </dd>
          </div>
        </dl>
        {event.registrationUrl && (
          <a
            class="button button--primary event-registration-button mt-6"
            href={event.registrationUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${event.registrationLabel ?? "S'inscrire"} — ouvre le formulaire Google Forms dans un nouvel onglet`}
          >
            {event.registrationLabel ?? "S'inscrire"}
          </a>
        )}
      </div>
    </section>

    <section class="event-detail-space bg-acbb-white" aria-labelledby="event-introduction-heading">
      <div class="site-container event-detail-introduction">
        <div>
          <h2 id="event-introduction-heading">Une soirée conviviale</h2>
          <p class="mt-3 max-w-2xl">{event.description}</p>
        </div>

        {event.poster ? (
          <img
            src={event.poster}
            alt={`Affiche de ${event.title}`}
            width="1200"
            height="1600"
            loading="lazy"
            decoding="async"
            class="event-detail-poster"
          />
        ) : null}
      </div>
    </section>

    {event.menu && event.menu.length > 0 && (
      <section class="event-detail-space" aria-labelledby="menu-heading">
        <div class="site-container">
          <p class="mb-3 font-bold text-acbb-red-hover">Au menu</p>
          <h2 id="menu-heading">Une soirée autour de bonnes choses</h2>
          <ol class="event-menu mt-5 md:mt-6">
            {event.menu.map((item) => (
              <li>
                <h3>{item.name}</h3>
                {item.choices && (
                  <p>Choix : {item.choices.join(" — ")}</p>
                )}
                {item.detail && <p>{item.detail}</p>}
              </li>
            ))}
          </ol>
        </div>
      </section>
    )}

    {event.prices && event.prices.length > 0 && (
      <section class="event-detail-space bg-acbb-white" aria-labelledby="prices-heading">
        <div class="site-container">
          <p class="mb-3 font-bold text-acbb-red-hover">Tarifs</p>
          <h2 id="prices-heading">Les prix du souper</h2>
          <dl class="event-prices mt-5 md:mt-6">
            {event.prices.map((price) => (
              <div>
                <dt>{price.label}</dt>
                <dd>{price.amount}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
    )}

    {registrationDeadline && event.registrationUrl && (
      <section class="event-detail-space" aria-labelledby="registration-heading">
        <div class="site-container event-registration">
          <div>
            <p class="mb-3 font-bold text-acbb-red-hover">Inscription</p>
            <h2 id="registration-heading">Réservez votre place</h2>
            <p class="mt-3">
              Inscriptions jusqu'au {registrationDeadline}.
            </p>
          </div>
          <div>
            <a
              class="button button--primary event-registration-button"
              href={event.registrationUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${event.registrationLabel ?? "S'inscrire"} — ouvre le formulaire Google Forms dans un nouvel onglet`}
            >
              {event.registrationLabel ?? "S'inscrire"}
            </a>
          </div>
        </div>
      </section>
    )}

    {event.paymentInformation && (
      <aside class="event-notice bg-acbb-soft-red" aria-label="Informations sur le paiement">
        <div class="site-container py-6 md:py-8">
          <p class="m-0 max-w-3xl">{event.paymentInformation}</p>
        </div>
      </aside>
    )}

    {event.dessertParticipation && (
      <section class="event-detail-space bg-acbb-white" aria-labelledby="dessert-heading">
        <div class="site-container">
          <h2 id="dessert-heading" class="text-2xl">Pâtisserie maison</h2>
          <p class="mt-3 max-w-3xl">{event.dessertParticipation}</p>
        </div>
      </section>
    )}
  </article>
</BaseLayout>
