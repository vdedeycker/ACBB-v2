---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  lang?: string;
}

const { title, description, lang = "fr" } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <main id="main-content">
      <slot />
    </main>
  </body>
</html>
