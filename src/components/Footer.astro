---
interface FooterItem {
  label: string;
  href?: string;
  target?: "_blank";
  rel?: "noopener noreferrer";
  ariaLabel?: string;
}

interface FooterGroup {
  title: string;
  items: FooterItem[];
}

const footerGroups: FooterGroup[] = [
  {
    title: "En pratique",
    items: [
      { label: "Entraînements", href: "/entrainements/" },
      { label: "Rejoindre l'ACBB", href: "/rejoindre/" },
      { label: "Compétitions", href: "/competitions/" },
      { label: "Événements ACBB", href: "/evenements/" },
    ],
  },
  {
    title: "Le club",
    items: [
      { label: "Le club", href: "/le-club/" },
      { label: "Handisport" },
      { label: "Vie du club" },
      { label: "Partenaires" },
      { label: "Contact" },
    ],
  },
  {
    title: "Informations",
    items: [
      { label: "Documents du club" },
      {
        label: "Règlement d’ordre intérieur",
        href: "/documents/club/reglement-ordre-interieur-acbb.pdf",
        target: "_blank",
        rel: "noopener noreferrer",
        ariaLabel:
          "Consulter le règlement d’ordre intérieur de l’ACBB au format PDF",
      },
      { label: "Confidentialité" },
    ],
  },
];
---

<footer class="bg-acbb-ink text-acbb-white">
  <div class="site-container py-10 md:py-12">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {footerGroups.map((group) => (
        <section aria-label={group.title}>
          <h2 class="mb-3 text-base font-semibold tracking-normal">
            {group.title}
          </h2>
          <ul class="m-0 list-none space-y-1 p-0 text-acbb-white/80">
            {group.items.map((item) => (
              <li class="py-1">
                {item.href ? (
                  <a
                    href={item.href}
                    target={item.target}
                    rel={item.rel}
                    aria-label={item.ariaLabel}
                    class="inline-flex min-h-11 items-center text-acbb-white no-underline"
                  >
                    {item.label}
                  </a>
                ) : (
                  item.label
                )}
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <div class="mt-8 border-t border-acbb-white/20 pt-5 text-sm text-acbb-white/80">
      <p class="m-0">ACBB</p>
      <p class="mt-1 mb-0">© {new Date().getFullYear()} ACBB</p>
    </div>
  </div>
</footer>
