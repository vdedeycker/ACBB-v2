---
import BaseLayout from "../layouts/BaseLayout.astro";
import CompetitionCard from "../components/CompetitionCard.astro";
import EventCard from "../components/EventCard.astro";
import { sortedCompetitions } from "../data/competitions";
import { sortedEvents } from "../data/events";
import { activeAnnouncements } from "../data/announcements";
import { sitePath } from "../utils/sitePath";

const upcomingCompetitionPreview = sortedCompetitions
  .filter((competition) => new Date(`${competition.date}T12:00:00`) >= new Date())
  .slice(0, 3);
const upcomingEventPreview = sortedEvents
  .filter((event) => new Date(`${event.date}T12:00:00`) >= new Date())
  .slice(0, 1);
const featuredAnnouncement = activeAnnouncements.find(
  (announcement) => announcement.featured,
);
---

<BaseLayout
  title="ACBB - Athletic Club Bernissart-Beloeil"
  description="Découvrez l'athlétisme à l'ACBB : entraînements, jeunes, handisport, compétitions et événements."
>
  <section class="overflow-hidden bg-acbb-beige" aria-labelledby="hero-heading">
    <div class="site-container grid items-center gap-8 py-10 md:py-14 lg:grid-cols-[0.9fr_1.1fr] lg:gap-12 lg:py-16">
      <div class="max-w-xl">
        <p class="mb-4 text-sm font-bold uppercase tracking-[0.12em] text-acbb-red-hover">
          Athletic Club Bernissart-Beloeil
        </p>
        <h1 id="hero-heading">L'athlétisme pour toutes et tous.</h1>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="future-action future-action--primary" href={sitePath("/entrainements/")}>
            Voir les entraînements
          </a>
          <a class="future-action future-action--primary" href={sitePath("/rejoindre/")}>
            Rejoindre l'ACBB
          </a>
        </div>
      </div>
      <img
        src={sitePath("/images/home/acbb-young-athlete-hero.jpg")}
        alt="Jeune athlète ACBB en pleine course pendant une compétition"
        width="2048"
        height="1363"
        fetchpriority="high"
        decoding="async"
        class="homepage-image aspect-[4/3] w-full object-cover object-[60%_center]"
      />
    </div>
  </section>

  {featuredAnnouncement && (
    <section class="bg-acbb-soft-red" aria-labelledby="announcement-heading">
      <div class="site-container flex flex-col gap-5 py-8 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="mb-2 text-sm font-bold uppercase tracking-[0.08em] text-acbb-red-hover">
            Annonce
          </p>
          <h2 id="announcement-heading" class="text-2xl md:text-3xl">
            {featuredAnnouncement.title}
          </h2>
          <p class="mt-3 max-w-2xl">
            {featuredAnnouncement.shortDescription}
          </p>
        </div>
        <a class="button button--primary shrink-0" href={sitePath("/vie-du-club/")}>
          Voir l'annonce
        </a>
      </div>
    </section>
  )}

  <section class="section-space bg-acbb-white" aria-labelledby="training-heading">
    <div class="site-container grid items-center gap-8 lg:grid-cols-2 lg:gap-14">
      <div class="order-2 lg:order-1">
        <p class="mb-3 font-bold text-acbb-red-hover">Entraînements</p>
        <h2 id="training-heading">Grandir, progresser et prendre plaisir à courir</h2>
        <p class="mt-5 max-w-xl">
          L'ACBB accueille différentes pratiques de l'athlétisme, du sport
          jeune aux disciplines plus spécifiques.
        </p>
        <ul class="mt-6 grid gap-2 sm:grid-cols-2" aria-label="Formules d'entraînement">
          <li class="rounded-full bg-acbb-beige px-4 py-3 font-semibold">École des jeunes</li>
          <li class="rounded-full bg-acbb-beige px-4 py-3 font-semibold">Sprint/haies/sauts</li>
          <li class="rounded-full bg-acbb-beige px-4 py-3 font-semibold">Demi-fond</li>
          <li class="rounded-full bg-acbb-beige px-4 py-3 font-semibold">Handisport</li>
        </ul>
        <a class="future-action mt-8" href={sitePath("/entrainements/")}>
          Voir les entraînements
        </a>
      </div>
      <div class="order-1 lg:order-2">
        <img
          src={sitePath("/images/training/track-training-session.jpg")}
          alt="Jeune athlète suivant un exercice sur la piste"
          width="1600"
          height="1200"
          loading="lazy"
          decoding="async"
          class="homepage-image aspect-[4/3] w-full object-cover object-center"
        />
      </div>
    </div>
  </section>

  <section class="section-space" aria-labelledby="handisport-heading">
    <div class="site-container grid items-center gap-8 lg:grid-cols-2 lg:gap-14">
      <img
        src={sitePath("/images/handisport/handisport-athletes.jpg")}
        alt="Athlètes pratiquant le handisport réunis sur une piste d'athlétisme"
        width="2048"
        height="1363"
        loading="lazy"
        decoding="async"
        class="homepage-image aspect-[4/3] w-full object-cover object-center"
      />
      <div>
        <p class="mb-3 font-bold text-acbb-red-hover">Handisport</p>
        <h2 id="handisport-heading">Une pratique sportive ouverte à chacun</h2>
        <p class="mt-5 max-w-xl">
          Le handisport occupe une place importante à l'ACBB. Il permet de
          partager les valeurs de l'athlétisme dans une activité dédiée à
          l'inclusion.
        </p>
        <span class="future-action mt-8">Découvrir le handisport</span>
      </div>
    </div>
  </section>

  <section class="section-space bg-acbb-white" aria-labelledby="competitions-heading">
    <div class="site-container grid items-center gap-8 lg:grid-cols-[0.85fr_1.15fr] lg:gap-14">
      <div>
        <p class="mb-3 font-bold text-acbb-red-hover">Compétitions</p>
        <h2 id="competitions-heading">Se mesurer, progresser et représenter l'ACBB</h2>
        <p class="mt-5 max-w-xl">
          Consultez les prochains rendez-vous Cross et Indoor de la saison
          2026-2027.
        </p>
        <div class="homepage-competition-preview mt-6">
          {upcomingCompetitionPreview.map((competition) => (
            <CompetitionCard competition={competition} homepagePreview />
          ))}
        </div>
        <a class="button button--primary mt-8" href={sitePath("/competitions/")}>
          Voir les compétitions
        </a>
      </div>
      <img
        src={sitePath("/images/competitions/competition-start.jpg")}
        alt="Athlètes ACBB prenant le départ d'une course"
        width="1718"
        height="1145"
        loading="lazy"
        decoding="async"
        class="homepage-image aspect-[16/10] w-full object-cover object-[center_38%]"
      />
    </div>
  </section>

  <section class="section-space" aria-labelledby="events-heading">
    <div class="site-container grid items-center gap-8 lg:grid-cols-2 lg:gap-14">
      <img
        src={sitePath("/images/events/acbb-event-athletes.webp")}
        alt="Athlètes vêtus aux couleurs de l'ACBB lors d'un événement"
        width="720"
        height="480"
        loading="lazy"
        decoding="async"
        class="homepage-image aspect-[3/2] w-full object-cover"
      />
      <div>
        <p class="mb-3 font-bold text-acbb-red-hover">Événements ACBB</p>
        <h2 id="events-heading">Des rendez-vous qui font vivre le club</h2>
        <p class="mt-5 max-w-xl">
          Retrouvez les prochains moments organisés par l'ACBB.
        </p>
        {upcomingEventPreview.length > 0 && (
          <div class="homepage-event-preview mt-6">
            {upcomingEventPreview.map((event) => (
              <EventCard event={event} homepagePreview />
            ))}
          </div>
        )}
        <a class="button button--primary mt-8" href={sitePath("/evenements/")}>
          Voir les événements ACBB
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
